# NutriScan AI failover — no Gemini required

# 1) Groq / Meta Llama 4 Scout
GROQ_API_KEY=your_groq_key
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# 2) OpenRouter / Google Gemma 4 free multimodal model
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# 3) OpenRouter's free-model router
# It selects an available free model compatible with the request,
# including image understanding when the request contains an image.
OPENROUTER_FREE_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://nutriscan-ai-copilot.onrender.com

AI_TIMEOUT_SECONDS=45
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./nutriscan.db
