# NutriScan AI Copilot — Frontend Environment Variables (Root Vercel Project)
#
# In local development, leave VITE_API_BASE_URL empty or set to /api so Vite's dev
# proxy forwards /api/* requests to http://localhost:8000.
#
# In production (Vercel Frontend Project -> Settings -> Environment Variables),
# set VITE_API_BASE_URL to your deployed FastAPI backend URL:
# Example: VITE_API_BASE_URL=https://your-nutriscan-backend.vercel.app
VITE_API_BASE_URL=
