# NutriScan AI Copilot - Vercel & Local Environment Variables

# Provider 1: Groq / Meta Llama 4 Scout
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Provider 2: OpenRouter / Google Gemma 4 Free Variant
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_SITE_URL=https://nutriscan-ai.vercel.app

# Provider 3: OpenRouter Free Models Router
OPENROUTER_FREE_MODEL=openrouter/free

# Configuration Settings
AI_TIMEOUT_SECONDS=45
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nutriscan-ai.vercel.app
